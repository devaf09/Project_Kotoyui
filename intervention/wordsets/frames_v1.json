{
 "name": "kotoyui_frames_v1",
 "note": "文型の表。{X} は語の枠。role は文の中の役（主題・主語・目的語・修飾・述語・親）。neg = 否定、natural = 意味が自然か（入れ替えで不自然になる対を作るため）。",
 "frames": [
  {"id": "F1_属性", "toks": ["{品種}", "は", "{味}", "。"], "roles": {"品種": "主題", "味": "述語"}},
  {"id": "F2_修飾", "toks": ["{色}", "{品種}", "は", "{味}", "。"], "roles": {"色": "修飾", "品種": "主題", "味": "述語"}},
  {"id": "F3_親子", "toks": ["{科}", "の", "{品種}", "は", "{味}", "。"], "roles": {"科": "親", "品種": "主題", "味": "述語"}},
  {"id": "F4_否定", "toks": ["{品種}", "は", "{味否定}", "。"], "roles": {"品種": "主題", "味否定": "述語"}, "neg": true},
  {"id": "F5_他動", "toks": ["{生き物}", "が", "{品種}", "を", "{動詞}", "。"], "roles": {"生き物": "主語", "品種": "目的語", "動詞": "述語"}},
  {"id": "F6_他動否定", "toks": ["{生き物}", "が", "{品種}", "を", "{動詞否定}", "。"], "roles": {"生き物": "主語", "品種": "目的語", "動詞否定": "述語"}, "neg": true},
  {"id": "F7_塗る", "toks": ["{生き物}", "が", "{品種}", "を", "{塗る色}", "塗った", "。"], "roles": {"生き物": "主語", "品種": "目的語", "塗る色": "変える値"}},
  {"id": "F8_熟す", "toks": ["{生き物}", "が", "{品種}", "を", "熟させた", "。"], "roles": {"生き物": "主語", "品種": "目的語"}},
  {"id": "F9_連鎖", "toks": ["{品種}", "は", "熟すと", "{色}", "なり", "、", "{味}", "なる", "。"], "roles": {"品種": "主題", "色": "結果1", "味": "結果2"}, "note": "A の出力（色）を B の入力（味）にする連鎖。色・味は連用形に直す"},
  {"id": "F10_並列", "toks": ["{品種}", "と", "{品種2}", "は", "{味}", "。"], "roles": {"品種": "主題", "品種2": "主題", "味": "述語"}, "note": "一括処理: 2 語を並べて同じ述語"}
 ]
}
